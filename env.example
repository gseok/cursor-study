# 환경 설정 예시 파일
# 실제 배포 시 Railway 대시보드에서 환경 변수 설정

# 개발 환경
# Railway 배포용 환경 변수 예시
NODE_ENV=production
PORT=8080

# Railway에서 자동으로 제공되는 변수들
# RAILWAY_STATIC_URL=your-app.up.railway.app
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_ENVIRONMENT=production

# 프로덕션 환경 (Railway에서 자동 설정)
# NODE_ENV=production
# PORT=자동설정
# RAILWAY_STATIC_URL=자동설정

# CORS 허용 도메인 (선택사항)
# ALLOWED_ORIGINS=https://your-client-domain.netlify.app,https://your-client-domain.vercel.app
